# pnpm settings for the Expo (React Native) app.
#
# Expo SDK 54 supports pnpm's default isolated installs, but React Native
# native modules (autolinking/Metro/native builds) can fail under isolation.
# Hoisting gives node_modules the same flat layout npm produced, which is the
# lowest-risk setup for RN native tooling. See Expo docs "Work with monorepos"
# (Common issues -> Package managers with isolated dependencies).
node-linker=hoisted
