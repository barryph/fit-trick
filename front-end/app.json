{
  "expo": {
    "name": "kadence",
    "slug": "kadence",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-default.png",
    "scheme": "myexpoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barryph.kadence",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.barryph.kadence",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#000923"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000923",
          "dark": {
            "backgroundColor": "#000923"
          }
        }
      ],
      [
        "expo-font"
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "091e86ec-9806-4bbd-b749-59678af11cf8"
      }
    },
    "owner": "barryph"
  }
}
