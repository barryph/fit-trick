POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=127.0.0.1
SESSION_SECRET=my-super-secret-key

# OAuth — Google
# Comma-separated Google OAuth 2.0 "Web application" client IDs (server/client
# IDs). These are the audiences the backend accepts in a Google ID token.
# Backend-only secret configuration; never expose via EXPO_PUBLIC_*.
GOOGLE_SERVER_CLIENT_IDS=

# OAuth — Apple
# Comma-separated Sign in with Apple client IDs. For a native iOS app this is
# the app's bundle identifier(s), e.g.
# com.barryph.kadence.dev,com.barryph.kadence.preview,com.barryph.kadence
APPLE_CLIENT_IDS=

# Override Apple's published JWKS endpoint (used in tests to point at a local
# server). Production should leave this unset.
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# Sign in with Apple client-secret material. Required to exchange the
# authorization code for a refresh token at sign-in and to revoke the user's
# authorization on account deletion. Either provide a precomputed
# APPLE_CLIENT_SECRET (an ES256 JWT signed with your Services ID key) or the
# key material to generate one:
APPLE_TEAM_ID=
APPLE_SERVICES_KEY_ID=
APPLE_SERVICES_PRIVATE_KEY=
# APPLE_CLIENT_SECRET=

# Override Apple's token/revoke endpoints (used in tests to point at local
# servers). Production should leave these unset.
# APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
# APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke

# Session lifetime. Idle = how long a session may go unused before it is
# revoked; absolute = the hard cap from sign-in, which rolling renewal can
# never extend past. Milliseconds. Defaults: 14 days and 60 days. Raising these
# lengthens how long a stolen session stays usable; lowering them signs
# infrequent users out sooner. See docs/session-management.md.
# SESSION_IDLE_TTL_MS=1209600000
# SESSION_ABSOLUTE_TTL_MS=5184000000

# Comma-separated allowed browser origins for CORS. Only relevant for web
# development; mobile clients send no Origin header. Defaults to localhost dev
# servers outside production, and to none in production.
#
# In production this must include the account-deletion site's origin, or the
# browser will refuse the public deletion endpoints.
CORS_ORIGINS=

# Account deletion without the app (required by Google Play).
#
# Absolute http(s) origin of the static account-deletion site. The emailed
# verification link is `${ACCOUNT_DELETION_SITE_URL}/delete?token=...`. Leave it
# unset and the email carries a mailto: link to ACCOUNT_DELETION_SUPPORT_EMAIL
# instead, so the flow still completes locally and in CI. A malformed value
# fails at startup rather than emailing a dead link.
ACCOUNT_DELETION_SITE_URL=

# Support address used by the mailto: fallback above.
# ACCOUNT_DELETION_SUPPORT_EMAIL=support@kadence.app
